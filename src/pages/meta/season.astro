---
// src/pages/meta/season.astro
// SSR page — shows meta analytics filtered to a specific season series.

import Layout from "../../layouts/Layout.astro";
import Main from "../../components/Main.astro";
import H1 from "../../components/H1.astro";
import MetaBreakdownChart from "../../components/charts/MetaBreakdownChart.astro";
import PlayerRankingChart from "../../components/charts/PlayerRankingChart.astro";
import FormatHealthChart from "../../components/charts/FormatHealthChart.astro";
import Top8PerformancesChart from "../../components/charts/Top8PerformancesChart.astro";
import "flatpickr/dist/flatpickr.min.css";

import {
  getMetaBreakdownBySeason,
  getPlayerLeaderboardBySeason,
  getFormatHealthBySeason,
  getOverviewStatsBySeason,
  getBest8LeaderboardBySeason,
  formatDateForDisplay,
  getEarliestTournamentDateBySeason,
  getTodayIsoDate,
  resolveDateRange,
  type MetaBreakdownEntry,
  type PlayerLeaderboardEntry,
  type FormatHealthEntry,
  type Best8LeaderboardEntry,
} from "../../lib/analytics";
import { useTranslations } from '../../i18n/index';

// Hardcoded seasons — add new season names here as they are created
const { locale } = Astro.locals;
const t = useTranslations(locale);
const SEASONS = ["Verdant Season", "Amber Season", "Copper Season"];

const url = new URL(Astro.request.url);
const season = SEASONS.includes(url.searchParams.get("season") ?? "")
  ? (url.searchParams.get("season") as string)
  : SEASONS[0];

const todayIso = getTodayIsoDate();
const seasonDefaultEntries = await Promise.all(
  SEASONS.map(async (seasonName) => [
    seasonName,
    (await getEarliestTournamentDateBySeason(seasonName)) ?? todayIso,
  ] as const),
);
const seasonDefaultFrom = Object.fromEntries(seasonDefaultEntries) as Record<string, string>;
const range = resolveDateRange({
  fromParam: url.searchParams.get("from"),
  toParam: url.searchParams.get("to"),
  defaultFrom: seasonDefaultFrom[season] ?? todayIso,
  defaultTo: todayIso,
});
const rangeFilter = {
  startDateUnix: range.startDateUnix,
  endDateUnixExclusive: range.endDateUnixExclusive,
};
const rangeLabel = `${formatDateForDisplay(range.from)} ${t.common.to} ${formatDateForDisplay(range.to)}`;

let metaBreakdown: MetaBreakdownEntry[] = [];
let leaderboard: PlayerLeaderboardEntry[] = [];
let formatHealth: FormatHealthEntry[] = [];
let best8Leaderboard: Best8LeaderboardEntry[] = [];
let stats = { totalTournaments: 0, totalEntries: 0, avgFieldSize: 0, uniquePlayers: 0 };
let error: string | null = null;

try {
  [metaBreakdown, leaderboard, formatHealth, stats, best8Leaderboard] = await Promise.all([
    getMetaBreakdownBySeason(season, rangeFilter),
    getPlayerLeaderboardBySeason(season, rangeFilter),
    getFormatHealthBySeason(season, rangeFilter),
    getOverviewStatsBySeason(season, rangeFilter),
    getBest8LeaderboardBySeason(season, rangeFilter),
  ]);
} catch (err) {
  error = `${t.meta.error}: ${err instanceof Error ? err.message : t.common.unknown}`;
}
---

<Layout title={`${season} | Pauper Colonia`}>
  <Main>
    <H1 text="Pauper Colonia Season Analytics" />

    <!-- Season Selector -->
    <form id="season-filter-form" method="get" class="filter-bar" data-locale={locale}>
      <label class="filter-label" for="season-select">{t.meta.season}</label>
      <select id="season-select" name="season" class="season-select">
        {SEASONS.map((s) => (
          <option value={s} selected={s === season}>{s}</option>
        ))}
      </select>

      <label class="filter-label" for="season-from">{t.meta.from}</label>
      <input
        id="season-from"
        class="date-input"
        type="text"
        name="from"
        value={formatDateForDisplay(range.from)}
        inputmode="numeric"
        placeholder="dd.MM.yyyy"
        pattern="(\\d{2}\\.\\d{2}\\.\\d{4}|\\d{4}-\\d{2}-\\d{2})"
      />

      <label class="filter-label" for="season-to">{t.meta.to}</label>
      <input
        id="season-to"
        class="date-input"
        type="text"
        name="to"
        value={formatDateForDisplay(range.to)}
        inputmode="numeric"
        placeholder="dd.MM.yyyy"
        pattern="(\\d{2}\\.\\d{2}\\.\\d{4}|\\d{4}-\\d{2}-\\d{2})"
      />

      <button type="submit" class="apply-btn">{t.meta.apply}</button>
      <a href="/meta" class="nav-pill-link">{t.meta.allTournaments}</a>
    </form>
    <script id="season-defaults" type="application/json" set:html={JSON.stringify(seasonDefaultFrom)}></script>

    {error ? (
      <div class="error-message">
        <p>{error}</p>
      </div>
    ) : (
      <>
        <!-- Overview Stats -->
        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-value">{stats?.totalTournaments ?? 0}</div>
            <div class="stat-label">{t.meta.stats.tournaments}</div>
          </div>
          <div class="stat-card">
            <div class="stat-value">{stats?.uniquePlayers ?? 0}</div>
            <div class="stat-label">{t.meta.stats.players}</div>
          </div>
          <div class="stat-card">
            <div class="stat-value">{stats?.avgFieldSize ?? 0}</div>
            <div class="stat-label">{t.meta.stats.avgParticipants}</div>
          </div>
          <div class="stat-card">
            <div class="stat-value">{stats?.totalEntries ?? 0}</div>
            <div class="stat-label">{t.meta.stats.totalEntries}</div>
          </div>
        </div>

        <!-- Charts Section -->
        <div class="charts-section">
          {metaBreakdown && metaBreakdown.length > 0 && (
            <div class="chart-card">
              <MetaBreakdownChart
                data={metaBreakdown}
                title={`${t.meta.charts.metaBreakdown} — ${season} (${rangeLabel})`}
              />
            </div>
          )}

          {leaderboard && leaderboard.length > 0 && (
            <div class="chart-card">
              <PlayerRankingChart
                data={leaderboard}
                title={`${t.meta.charts.playerRanking} — ${season} (${rangeLabel})`}
                maxPlayers={leaderboard.length}
                season={season}
                from={range.from}
                to={range.to}
              />
            </div>
          )}

          {best8Leaderboard && best8Leaderboard.length > 0 && (
            <div class="chart-card">
              <Top8PerformancesChart
                data={best8Leaderboard}
                title={`${t.meta.charts.top8} (${season}, ${rangeLabel})`}
                season={season}
                from={range.from}
                to={range.to}
              />
            </div>
          )}

          {formatHealth && formatHealth.length > 0 && (
            <div class="chart-card">
              <FormatHealthChart
                data={formatHealth}
                title={`${t.meta.charts.formatHealth} — ${season} (${rangeLabel})`}
              />
            </div>
          )}
        </div>

        {(!metaBreakdown || metaBreakdown.length === 0) &&
         (!leaderboard || leaderboard.length === 0) &&
         (!formatHealth || formatHealth.length === 0) && (
          <div class="empty-state">
            <p>{t.meta.empty.season}</p>
            <p>{t.meta.empty.retry}</p>
          </div>
        )}
      </>
    )}
  </Main>
</Layout>

<script>
  import flatpickr from "flatpickr";
  import { German } from "flatpickr/dist/l10n/de.js";

  document.addEventListener("astro:page-load", () => {
    const form = document.getElementById("season-filter-form") as HTMLFormElement | null;
    const select = document.getElementById("season-select") as HTMLSelectElement | null;
    const fromInput = document.getElementById("season-from") as HTMLInputElement | null;
    const toInput = document.getElementById("season-to") as HTMLInputElement | null;
    const defaultsEl = document.getElementById("season-defaults");
    const seasonDefaults = defaultsEl?.textContent ? JSON.parse(defaultsEl.textContent) as Record<string, string> : {};

    const isGerman = form?.dataset.locale === 'de';
    const pickerOptions = {
      ...(isGerman ? { locale: German } : {}),
      dateFormat: "d.m.Y",
      allowInput: true,
      disableMobile: true,
    };

    if (fromInput) {
      const fromWithPicker = fromInput as HTMLInputElement & { _flatpickr?: { destroy: () => void } };
      if (fromWithPicker._flatpickr) fromWithPicker._flatpickr.destroy();
      flatpickr(fromInput, pickerOptions);
    }

    if (toInput) {
      const toWithPicker = toInput as HTMLInputElement & { _flatpickr?: { destroy: () => void } };
      if (toWithPicker._flatpickr) toWithPicker._flatpickr.destroy();
      flatpickr(toInput, pickerOptions);
    }

    if (form && select && fromInput) {
      const isoToGerman = (value: string | undefined) => {
        if (!value) return "";
        const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value);
        if (!match) return value;
        return `${match[3]}.${match[2]}.${match[1]}`;
      };

      let previousSeason = select.value;

      select.addEventListener("change", () => {
        const nextSeason = select.value;
        const previousDefault = isoToGerman(seasonDefaults[previousSeason]);
        const nextDefault = isoToGerman(seasonDefaults[nextSeason]);
        const fromWasDefault = !fromInput.value || fromInput.value === previousDefault;

        if (fromWasDefault && nextDefault) {
          fromInput.value = nextDefault;
        }

        previousSeason = nextSeason;
        form.requestSubmit();
      });
    }
  });
</script>

<style>
  .filter-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 1.5rem 0;
    flex-wrap: wrap;
  }

  .filter-label {
    font-weight: 600;
    font-size: 0.95rem;
    color: #555;
  }

  .season-select {
    padding: 0.5rem 1rem;
    border: 2px solid #0066cc;
    border-radius: 0.375rem;
    font-size: 1rem;
    font-weight: 600;
    color: #0066cc;
    background: #fff;
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
  }

  .season-select:hover,
  .season-select:focus {
    border-color: #0052a3;
    background: #0066cc;
    color: #fff;
    outline: none;
  }

  .season-select option {
    background: #fff;
    color: #333;
    font-weight: normal;
  }

  .date-input {
    padding: 0.5rem 0.6rem;
    border: 1px solid #ddd;
    border-radius: 0.375rem;
    font-size: 0.95rem;
    color: #333;
    background: #fff;
    width: 12.5ch;
  }

  .date-input:focus {
    outline: none;
    border-color: #0066cc;
    box-shadow: 0 0 0 2px rgba(0, 102, 204, 0.15);
  }

  .apply-btn {
    padding: 0.5rem 0.8rem;
    border: 1px solid #0066cc;
    border-radius: 0.375rem;
    background: #0066cc;
    color: #fff;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .apply-btn:hover {
    background: #0052a3;
  }



  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1rem;
    margin: 1.5rem 0 2rem;
  }

  .stat-card {
    background: #fafafa;
    border: 1px solid #eee;
    border-radius: 0.5rem;
    padding: 1.25rem;
    text-align: center;
  }

  .stat-value {
    font-size: 1.8rem;
    font-weight: 700;
    color: #0066cc;
  }

  .stat-label {
    font-size: 0.85rem;
    color: #666;
    margin-top: 0.25rem;
  }

  .charts-section {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    margin: 2rem 0;
  }

  .chart-card {
    background: #fafafa;
    border: 1px solid #eee;
    border-radius: 0.5rem;
    padding: 1.5rem;
  }

  .empty-state {
    text-align: center;
    padding: 3rem 1rem;
    color: #888;
  }

  .empty-state p {
    margin: 0.5rem 0;
  }

  .error-message {
    background-color: #fee;
    border: 1px solid #fcc;
    border-radius: 0.5rem;
    padding: 1rem;
    margin: 1rem 0;
    color: #c33;
  }

  .back-link {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid #eee;
  }

  .back-link a {
    color: #0066cc;
    text-decoration: none;
    font-weight: 500;
  }

  .back-link a:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .stat-value {
      font-size: 1.4rem;
    }
  }
</style>
