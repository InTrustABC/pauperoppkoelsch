---
// src/pages/meta/season.astro
// SSR page — shows meta analytics filtered to a specific season series.

import Layout from "../../layouts/Layout.astro";
import Main from "../../components/Main.astro";
import H1 from "../../components/H1.astro";
import MetaBreakdownChart from "../../components/charts/MetaBreakdownChart.astro";
import PlayerRankingChart from "../../components/charts/PlayerRankingChart.astro";
import FormatHealthChart from "../../components/charts/FormatHealthChart.astro";
import Top8PerformancesChart from "../../components/charts/Top8PerformancesChart.astro";

import {
  getMetaBreakdownBySeason,
  getPlayerLeaderboardBySeason,
  getFormatHealthBySeason,
  getOverviewStatsBySeason,
  getBest8LeaderboardBySeason,
  type MetaBreakdownEntry,
  type PlayerLeaderboardEntry,
  type FormatHealthEntry,
  type Best8LeaderboardEntry,
} from "../../lib/analytics";

// Hardcoded seasons — add new season names here as they are created
const SEASONS = ["Verdant Season", "Amber Season"];

const url = new URL(Astro.request.url);
const season = SEASONS.includes(url.searchParams.get("season") ?? "")
  ? (url.searchParams.get("season") as string)
  : SEASONS[0];

let metaBreakdown: MetaBreakdownEntry[] = [];
let leaderboard: PlayerLeaderboardEntry[] = [];
let formatHealth: FormatHealthEntry[] = [];
let best8Leaderboard: Best8LeaderboardEntry[] = [];
let stats = { totalTournaments: 0, totalEntries: 0, avgFieldSize: 0, uniquePlayers: 0 };
let error: string | null = null;

try {
  [metaBreakdown, leaderboard, formatHealth, stats, best8Leaderboard] = await Promise.all([
    getMetaBreakdownBySeason(season),
    getPlayerLeaderboardBySeason(season),
    getFormatHealthBySeason(season),
    getOverviewStatsBySeason(season),
    getBest8LeaderboardBySeason(season),
  ]);
} catch (err) {
  error = `Daten konnten nicht geladen werden: ${err instanceof Error ? err.message : "Unbekannter Fehler"}`;
}
---

<Layout title={`${season} | Pauper Colonia`}>
  <Main>
    <H1 text="Pauper Colonia Season Analytics" />

    <!-- Season Selector -->
    <div class="filter-bar">
      <label class="filter-label" for="season-select">Saison:</label>
      <select id="season-select" class="season-select">
        {SEASONS.map((s) => (
          <option value={s} selected={s === season}>{s}</option>
        ))}
      </select>
      <a href="/meta" class="nav-pill-link">Alle Turniere →</a>
    </div>

    {error ? (
      <div class="error-message">
        <p>{error}</p>
      </div>
    ) : (
      <>
        <!-- Overview Stats -->
        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-value">{stats?.totalTournaments ?? 0}</div>
            <div class="stat-label">Turniere</div>
          </div>
          <div class="stat-card">
            <div class="stat-value">{stats?.uniquePlayers ?? 0}</div>
            <div class="stat-label">Spieler</div>
          </div>
          <div class="stat-card">
            <div class="stat-value">{stats?.avgFieldSize ?? 0}</div>
            <div class="stat-label">Ø Teilnehmer</div>
          </div>
          <div class="stat-card">
            <div class="stat-value">{stats?.totalEntries ?? 0}</div>
            <div class="stat-label">Gesamt Einträge</div>
          </div>
        </div>

        <!-- Charts Section -->
        <div class="charts-section">
          {metaBreakdown && metaBreakdown.length > 0 && (
            <div class="chart-card">
              <MetaBreakdownChart
                data={metaBreakdown}
                title={`Meta Breakdown — ${season}`}
              />
            </div>
          )}

          {leaderboard && leaderboard.length > 0 && (
            <div class="chart-card">
              <PlayerRankingChart
                data={leaderboard}
                title={`Spieler Ranking — ${season}`}
                maxPlayers={leaderboard.length}
              />
            </div>
          )}

          {best8Leaderboard && best8Leaderboard.length > 0 && (
            <div class="chart-card">
              <Top8PerformancesChart
                data={best8Leaderboard}
                title={`Top 8 Spieler — Besten 8 Turniere (${season})`}
              />
            </div>
          )}

          {formatHealth && formatHealth.length > 0 && (
            <div class="chart-card">
              <FormatHealthChart
                data={formatHealth}
                title={`Format Health — ${season}`}
              />
            </div>
          )}
        </div>

        {(!metaBreakdown || metaBreakdown.length === 0) &&
         (!leaderboard || leaderboard.length === 0) &&
         (!formatHealth || formatHealth.length === 0) && (
          <div class="empty-state">
            <p>Keine Daten für diese Saison vorhanden.</p>
            <p>Die Datenbank wird täglich aktualisiert. Bitte versuche es später erneut.</p>
          </div>
        )}
      </>
    )}
  </Main>
</Layout>

<script>
  const select = document.getElementById("season-select") as HTMLSelectElement;
  select?.addEventListener("change", () => {
    const params = new URLSearchParams(window.location.search);
    params.set("season", select.value);
    window.location.href = `/meta/season?${params.toString()}`;
  });
</script>

<style>
  .filter-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 1.5rem 0;
    flex-wrap: wrap;
  }

  .filter-label {
    font-weight: 600;
    font-size: 0.95rem;
    color: #555;
  }

  .season-select {
    padding: 0.5rem 1rem;
    border: 2px solid #0066cc;
    border-radius: 0.375rem;
    font-size: 1rem;
    font-weight: 600;
    color: #0066cc;
    background: #fff;
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
  }

  .season-select:hover,
  .season-select:focus {
    border-color: #0052a3;
    background: #0066cc;
    color: #fff;
    outline: none;
  }

  .season-select option {
    background: #fff;
    color: #333;
    font-weight: normal;
  }



  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1rem;
    margin: 1.5rem 0 2rem;
  }

  .stat-card {
    background: #fafafa;
    border: 1px solid #eee;
    border-radius: 0.5rem;
    padding: 1.25rem;
    text-align: center;
  }

  .stat-value {
    font-size: 1.8rem;
    font-weight: 700;
    color: #0066cc;
  }

  .stat-label {
    font-size: 0.85rem;
    color: #666;
    margin-top: 0.25rem;
  }

  .charts-section {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    margin: 2rem 0;
  }

  .chart-card {
    background: #fafafa;
    border: 1px solid #eee;
    border-radius: 0.5rem;
    padding: 1.5rem;
  }

  .empty-state {
    text-align: center;
    padding: 3rem 1rem;
    color: #888;
  }

  .empty-state p {
    margin: 0.5rem 0;
  }

  .error-message {
    background-color: #fee;
    border: 1px solid #fcc;
    border-radius: 0.5rem;
    padding: 1rem;
    margin: 1rem 0;
    color: #c33;
  }

  .back-link {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid #eee;
  }

  .back-link a {
    color: #0066cc;
    text-decoration: none;
    font-weight: 500;
  }

  .back-link a:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .stat-value {
      font-size: 1.4rem;
    }
  }
</style>
