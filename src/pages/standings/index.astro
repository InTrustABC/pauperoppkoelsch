---
// src/pages/standings/index.astro
// SSR page — fetches tournament list from the database.
import Layout from "../../layouts/Layout.astro";
import Main from "../../components/Main.astro";
import H1 from "../../components/H1.astro";
import { getAllTournaments, type Tournament } from "../../lib/db";
import { useTranslations } from '../../i18n/index';

let tournaments: Tournament[] = [];
let error: string | null = null;

const { locale } = Astro.locals;
const t = useTranslations(locale);

try {
    tournaments = await getAllTournaments(90);
} catch (err) {
    error = `${t.standings.error}: ${err instanceof Error ? err.message : t.common.unknown}`;
}
---

<Layout title="Meta & Standings | Pauper Colonia">
    <Main>
        <H1 text={t.standings.title} />

        {
            error ? (
                <div class="error-message">
                    <p>{error}</p>
                </div>
            ) : tournaments.length > 0 ? (
                <div class="tournaments-container">
                    {tournaments.map((tournament) => (
                        <div class="tournament-card-wrapper">
                            <a
                                href={`/standings/${tournament.tid}`}
                                class="tournament-card-link"
                            >
                                <div class="tournament-card">
                                    <h2>{tournament.tournament_name}</h2>
                                    <div class="tournament-info">
                                        <p>
                                            <strong>{t.standings.labels.format}:</strong>{" "}
                                            {tournament.format}
                                        </p>
                                        <p>
                                            <strong>{t.standings.labels.players}:</strong>{" "}
                                            {tournament.players}
                                        </p>
                                        <p>
                                            <strong>{t.standings.labels.rounds}:</strong>{" "}
                                            {tournament.swiss_rounds}
                                        </p>
                                        {tournament.top_cut > 0 && (
                                            <p>
                                                <strong>{t.standings.labels.topCut}:</strong>{" "}
                                                {tournament.top_cut}
                                            </p>
                                        )}
                                        <p>
                                            <strong>{t.standings.labels.date}:</strong>{" "}
                                            {new Date(
                                                tournament.start_date * 1000,
                                            ).toLocaleDateString(locale === 'de' ? 'de-DE' : 'en-US')}
                                        </p>
                                    </div>
                                </div>
                            </a>
                        </div>
                    ))}
                </div>
            ) : (
                <div class="loading-message">
                    <p>Loading tournaments...</p>
                </div>
            )
        }
    </Main>
</Layout>

<style>
    .error-message {
        background-color: #fee;
        border: 1px solid #fcc;
        border-radius: 0.5rem;
        padding: 1rem;
        margin: 1rem 0;
        color: #c33;
    }

    .error-message p {
        margin: 0.5rem 0;
    }

    .tournaments-container {
        display: grid;
        gap: 1.5rem;
        margin: 2rem 0;
    }

    .tournament-card-wrapper {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .tournament-card-link {
        text-decoration: none;
        color: inherit;
        display: block;
    }

    .tournament-card {
        border: 1px solid #ddd;
        border-radius: 0.5rem;
        padding: 1.5rem;
        background-color: #fafafa;
        transition: all 0.3s ease;
    }

    .tournament-card-link:hover .tournament-card {
        border-color: #999;
        background-color: #f5f5f5;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .tournament-card h2 {
        margin: 0 0 1rem 0;
        color: inherit;
    }

    .tournament-card-link:hover .tournament-card h2 {
        color: #0066cc;
    }

    .tournament-info {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .tournament-info p {
        margin: 0;
        font-size: 0.95rem;
    }

    .loading-message {
        background-color: #f0f0f0;
        border-radius: 0.5rem;
        padding: 2rem;
        text-align: center;
        color: #666;
    }
</style>
