---
import { Image } from "astro:assets";
import H1 from "../components/H1.astro";
import Main from "../components/Main.astro";
import Layout from "../layouts/Layout.astro";
import AnimatedText from "../components/ui/AnimatedText.astro";
import pccprimaryImg from "../assets/pccprimary.jpeg";
import IndexCard from "../components/IndexCard.astro";
import spicerackImg from "../assets/spicerack_indexPage.JPG";
import metaAndStandingsImg from "../assets/metaAndStandings_indexPage.JPEG";
import PostList from "../components/PostList.astro";
import FeaturedPostList from "../components/FeaturedPostList.astro";
import MapSection from "../components/MapSection.astro";
import { getCollection } from "astro:content";

const MaxFeaturedPosts = 3;
const allPosts = await getCollection("posts");
const featuredPosts = allPosts
	.filter((p) => Boolean(p.data.featured))
	.sort((a, b) => +new Date(b.data.date) - +new Date(a.data.date))
	.slice(0, MaxFeaturedPosts);
---

<!-- Initializing AOS for fade animations -->
<script>
	import AOS from "aos";
	import "aos/dist/aos.css";
	AOS.init();
</script>

<Layout title="Pauper Colonia">
	<Main>
		<H1 text="Pauper Colonia" />
		<div
			class="relative site-container z-20 w-full mx-auto mt-16 px-4 md:mt-18 lg:mt-20 xl:px-0"
		>
			<div class="md:flex md:items-start md:gap-10">
				<div
					class="prose prose-2xl overflow-visible relative mb-20 md:mb-0 md:w-2/3"
				>
					<h2
						class="mb-4"
						data-aos="fade-right"
						data-aos-delay="300"
						data-aos-duration="800"
						data-aos-once="true"
					>
						<!-- <AnimatedText
							content="Pauper opp Kölsch!"
							delay={0.2}
							duration={0.5}
							stagger={0.08}
							class="text-5xl text-pri leading-tight md:text-4xl lg:text-6xl font-brand"
						/> -->
						"Pauper opp Kölsch!"
					</h2>
					Wir sind eine Gruppe von passionierten Pauper Spielern, die sich
					jeden Mittwoch im Vereinsheim von <a
						href="https://cbg.cologne"
						target="_blank"
						rel="noopener noreferrer"
					>
						Card & Board Games Cologne e.V.
					</a> in der Kölner Südstadt trifft um Pauper zu spielen. Je nach
					Teilnehmerzahl sind es kleinere Turniere mit mindestens drei Runden.
					<br />
					<br />
					Für Vereinsmitglieder ist das Turnier frei, Nicht-Mitglieder werden
					um eine Spende von 4 Euro gebeten.
					<br />
					<br />
					Wir freuen uns, wenn die Pauper Community weiter wächst und wir
					auch dich bei uns begrüßen dürfen!
					<br />
				</div>
				<div
					class="relative w-full mt-16 md:mt-0 md:w-1/3"
					data-aos="fade-left"
					data-aos-delay="300"
					data-aos-duration="800"
					data-aos-once="true"
				>
					<Image
						src={pccprimaryImg}
						alt="Colonia Logo"
						width={600}
						height={600 / 1.5}
						class="rounded-2xl shadow-xl mb-6 aspect-thumbnail object-cover"
					/>
				</div>
			</div>
		</div>
		<div class="w-screen -ml-[calc((100vw-100%)/2)] bg-gray-100 py-6 mt-6">
			<div class="text-center text-lg font-semibold text-gray-800">
				Jeden zweiten Mittwoch ab 18:30 Uhr
			</div>
		</div>
		<div id="cardBlock" class="flex flex-col md:flex-row gap-6 md:gap-8">
			<div
				class="mt-20"
				data-aos="fade-right"
				data-aos-delay="300"
				data-aos-duration="800"
				data-aos-once="true"
			>
				<IndexCard
					image={spicerackImg}
					header="Spicerack Anmeldung"
					description="Meldet euch per Spicerack für unser Bi-Weekly im Vereinsheim von Card & Boardgames Cologne an. Wir freuen uns auf euch!"
					buttonText="Komm vorbei"
					buttonLink="https://www.spicerack.gg/events/stores/8703"
				/>
			</div>
			<div
				class="mt-20"
				data-aos="fade-left"
				data-aos-delay="300"
				data-aos-duration="800"
				data-aos-once="true"
			>
				<IndexCard
					image={metaAndStandingsImg}
					header="Meta & Standings"
					description="Hier findest du die aktuellen Meta- und Standings-Informationen für Pauper."
					buttonText="Zur Meta & Standings"
					buttonLink="https://docs.google.com/spreadsheets/d/e/2PACX-1vSx8-lX9swWBHFUU42eK34IqGaEjLai4ZxhTW11l80ZR2fcMNQI1b9ncFbXVjyJ1l0DQQifGb1Xr5jp/pubhtml?gid=732179563&single=true"
				/>
			</div>
		</div>
		{
			featuredPosts.length ? (
				<div class="mt-12 site-container bg-gray-100 rounded-xl p-8">
					<h3 class="text-3xl mb-6">Featured</h3>
					<FeaturedPostList posts={featuredPosts} />
				</div>
			) : null
		}

		<MapSection />
	</Main>
</Layout>
