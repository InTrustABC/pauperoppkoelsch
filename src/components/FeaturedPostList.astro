---
import type { CollectionEntry } from "astro:content";

import Post from "./Post.astro";

type Props = {
    posts: CollectionEntry<"posts">[];
};

const { posts } = Astro.props;
---

<div
    class="grid grid-cols-3 gap-x-8 gap-y-12 max-md:grid-cols-2 max-sm:gap-y-14"
>
    {posts.map((post) => <Post post={post} compact={true} />)}
</div>
