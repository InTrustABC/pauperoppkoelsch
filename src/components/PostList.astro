---
import type { CollectionEntry } from "astro:content";

import Post from "./Post.astro";

type Props = {
    posts: CollectionEntry<"posts">[];
    compact?: boolean;
};

const { posts, compact = false } = Astro.props;
---

<div
    class={
        `grid ${compact ? 'grid-cols-3 gap-x-8 gap-y-12 max-md:grid-cols-2' : 'grid-cols-2 gap-x-16 gap-y-32 max-md:grid-cols-1'} max-sm:gap-y-14`
    }
>
    {posts.map((post) => <Post post={post} compact={compact} />)}
</div>
