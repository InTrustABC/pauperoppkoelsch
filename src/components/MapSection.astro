---
import { useTranslations } from '../i18n/index';

const { locale } = Astro.locals;
const t = useTranslations(locale);
---

<div class="mt-12 w-screen -ml-[calc((100vw-100%)/2)] bg-gray-100 p-8 mb-4">
    <div class="site-container mx-auto">
        <h3 class="text-3xl mb-6 text-center">
            {t.map.heading}
        </h3>
        <div class="mb-6 flex justify-center">
            <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2515.157433016824!2d6.951767977156598!3d50.92080467168574!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47bf250061ccdbbd%3A0xfa1360df86b79ce9!2sCard%20%26%20Board%20Games%20Cologne%20e.V.!5e0!3m2!1sde!2sde!4v1770948403687!5m2!1sde!2sde"
                width="600"
                height="450"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
        <div class="flex justify-center">
            <a
                href="https://melee.gg/Hub/Organization/18559"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block bg-white text-black border-2 border-black rounded-md px-2 py-1 hover:bg-gray-100 transition-colors underline"
            >
                {t.map.register}
            </a>
        </div>
    </div>
</div>
