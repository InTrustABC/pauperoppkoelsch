---
/**
 * Top8PerformancesChart — Horizontal bar chart showing top 8 players ranked
 * by the sum of their best 8 tournament point scores in a season.
 */
interface Props {
    data: {
        player_name: string;
        best8_points: number;
        best8_wins: number;
        best8_losses: number;
        best8_draws: number;
        avg_omw_pct: number | null;
        avg_tgw_pct: number | null;
        avg_ogw_pct: number | null;
        tournaments_counted: number;
        tournaments_played: number;
    }[];
    title?: string;
    season?: string;
}

const { data, title = "Top 8 — Besten Turniere", season = "" } = Astro.props;

const chartHeight = Math.max(350, data.length * 50);

const chartData = JSON.stringify({
    labels: data.map((p) => p.player_name),
    points: data.map((p) => p.best8_points),
    tiebreakers: data.map((p) => ({
        omw: p.avg_omw_pct,
        tgw: p.avg_tgw_pct,
        ogw: p.avg_ogw_pct,
    })),
    records: data.map(
        (p) =>
            `${p.best8_wins}W-${p.best8_losses}L-${p.best8_draws}D | ${p.tournaments_counted}/${p.tournaments_played} Turniere gewertet`,
    ),
    season,
});
---

<div class="chart-container" style={`height: ${chartHeight}px;`}>
    <h3 class="chart-title">{title}</h3>
    <canvas
        id="top8PerformancesChart"
        data-chart={chartData}
        width="600"
        height={chartHeight - 50}></canvas>
</div>

<script>
    import {
        Chart,
        BarController,
        BarElement,
        CategoryScale,
        LinearScale,
        Tooltip,
        Legend,
    } from "chart.js";
    Chart.register(
        BarController,
        BarElement,
        CategoryScale,
        LinearScale,
        Tooltip,
        Legend,
    );

    import { openPlayerDeckModal } from "../../lib/playerDeckModal";

    document.addEventListener("astro:page-load", () => {
        const canvas = document.getElementById(
            "top8PerformancesChart",
        ) as HTMLCanvasElement;
        if (!canvas) return;

        const existing = Chart.getChart(canvas);
        if (existing) existing.destroy();

        const parsed = JSON.parse(canvas.dataset.chart!);

        const PLAYER_COLORS = [
            "#6366f1",
            "#10b981",
            "#f59e0b",
            "#ef4444",
            "#3b82f6",
            "#ec4899",
            "#14b8a6",
            "#f97316",
        ];

        new Chart(canvas, {
            type: "bar",
            data: {
                labels: parsed.labels,
                datasets: [
                    {
                        label: "Punkte (Top 8 Turniere)",
                        data: parsed.points,
                        backgroundColor: parsed.points.map((_: number, i: number) =>
                            PLAYER_COLORS[i % PLAYER_COLORS.length],
                        ),
                        borderWidth: 1,
                        borderColor: "#fff",
                        borderRadius: 4,
                    },
                ],
            },
            options: {
                indexAxis: "y",
                responsive: true,
                maintainAspectRatio: false,
                layout: { padding: { bottom: 20 } },
                scales: {
                    x: {
                        beginAtZero: true,
                        title: { display: true, text: "Punkte (Top 8 Turniere)" },
                    },
                    y: {
                        ticks: { font: { size: 12 } },
                    },
                },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            afterLabel: (ctx) => {
                                const i = ctx.dataIndex;
                                const record = parsed.records[i];
                                const tb = parsed.tiebreakers?.[i];

                                if (!tb) return record;

                                const formatPct = (
                                    value: number | null | undefined,
                                ) =>
                                    typeof value === "number" &&
                                    Number.isFinite(value)
                                        ? `${(value * 100).toFixed(2)}%`
                                        : "n/a";

                                return [
                                    record,
                                    `OMW: ${formatPct(tb.omw)} | TGW: ${formatPct(tb.tgw)} | OGW: ${formatPct(tb.ogw)}`,
                                ];
                            },
                        },
                    },
                },
                onHover: (_event, elements) => {
                    canvas.style.cursor = elements.length ? "pointer" : "default";
                },
                onClick: (_event, elements) => {
                    if (!elements.length) return;
                    const i = elements[0].index;
                    openPlayerDeckModal(parsed.labels[i], parsed.season || undefined);
                },
            },
        });
    });
</script>

<style>
    .chart-container {
        position: relative;
        width: 100%;
        max-width: 800px;
        margin: 0 auto;
    }
    .chart-title {
        text-align: center;
        margin-bottom: 0.5rem;
        font-size: 1.1rem;
        font-weight: 600;
    }
</style>
