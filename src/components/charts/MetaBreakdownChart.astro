---
/**
 * MetaBreakdownChart — Doughnut chart showing deck archetype distribution.
 * Pass data as a JSON-serializable prop; Chart.js renders client-side.
 */
interface Props {
    /** Array of { deck_archetype: string, total_count: number, avg_percentage: number } */
    data: {
        deck_archetype: string;
        total_count: number;
        avg_percentage: number;
    }[];
    title?: string;
}

const { data, title = "Meta Breakdown" } = Astro.props;

// Top 20 + "Other"
const sorted = [...data].sort((a, b) => b.total_count - a.total_count);
const top = sorted.slice(0, 20);
const rest = sorted.slice(20);

if (rest.length > 0) {
    top.push({
        deck_archetype: "Sonstige",
        total_count: rest.reduce((s, d) => s + d.total_count, 0),
        avg_percentage: rest.reduce((s, d) => s + d.avg_percentage, 0),
    });
}

const chartData = JSON.stringify({
    labels: top.map((d) => d.deck_archetype),
    counts: top.map((d) => d.total_count),
});
---

<div class="chart-container">
    <h3 class="chart-title">{title}</h3>
    <canvas
        id="metaBreakdownChart"
        data-chart={chartData}
        width="500"
        height="500"></canvas>
</div>

<script>
    import {
        Chart,
        DoughnutController,
        ArcElement,
        Tooltip,
        Legend,
    } from "chart.js";
    import ChartDataLabels from "chartjs-plugin-datalabels";
    Chart.register(
        DoughnutController,
        ArcElement,
        Tooltip,
        Legend,
        ChartDataLabels,
    );

    document.addEventListener("astro:page-load", () => {
        const canvas = document.getElementById(
            "metaBreakdownChart",
        ) as HTMLCanvasElement;
        if (!canvas) return;

        const existing = Chart.getChart(canvas);
        if (existing) existing.destroy();

        const parsed = JSON.parse(canvas.dataset.chart!);

        const isMobile = window.innerWidth <= 640;

        const colors = [
            "#3b82f6",
            "#ef4444",
            "#10b981",
            "#f59e0b",
            "#8b5cf6",
            "#ec4899",
            "#06b6d4",
            "#84cc16",
            "#f97316",
            "#6366f1",
            "#9ca3af",
        ];

        // Custom plugin to draw connector lines from slice to outside label (desktop only)
        const connectorLinePlugin = {
            id: "connectorLines",
            afterDatasetsDraw(chart: any) {
                if (isMobile) return;
                const meta = chart.getDatasetMeta(0);
                if (!meta || !meta.data) return;
                const ctx = chart.ctx;

                meta.data.forEach((arc: any, i: number) => {
                    if (!chart.getDataVisibility(i)) return;

                    const centerX = arc.x;
                    const centerY = arc.y;
                    const midAngle = (arc.startAngle + arc.endAngle) / 2;
                    const outerRadius = arc.outerRadius;

                    const edgeX = centerX + Math.cos(midAngle) * outerRadius;
                    const edgeY = centerY + Math.sin(midAngle) * outerRadius;

                    const labelRadius = outerRadius + 28;
                    const labelX = centerX + Math.cos(midAngle) * labelRadius;
                    const labelY = centerY + Math.sin(midAngle) * labelRadius;

                    ctx.save();
                    ctx.beginPath();
                    ctx.moveTo(edgeX, edgeY);
                    ctx.lineTo(labelX, labelY);
                    ctx.strokeStyle = "#888";
                    ctx.lineWidth = 1;
                    ctx.stroke();
                    ctx.restore();
                });
            },
        };

        new Chart(canvas, {
            type: "doughnut",
            plugins: [connectorLinePlugin],
            data: {
                labels: parsed.labels,
                datasets: [
                    {
                        data: parsed.counts,
                        backgroundColor: colors.slice(0, parsed.labels.length),
                        borderWidth: 2,
                        borderColor: "#fff",
                    },
                ],
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                onClick: (_event: any, elements: any[], chart: any) => {
                    if (elements.length > 0) {
                        const index = elements[0].index;
                        chart.toggleDataVisibility(index);
                        chart.update();
                    }
                },
                layout: {
                    padding: isMobile
                        ? { top: 10, bottom: 10, left: 10, right: 10 }
                        : { top: 60, bottom: 60, left: 80, right: 120 },
                },
                plugins: {
                    legend: {
                        display: isMobile,
                        position: "bottom",
                        labels: {
                            padding: 12,
                            usePointStyle: true,
                            pointStyle: "circle",
                            font: { size: 10 },
                        },
                    },
                    tooltip: {
                        callbacks: {
                            label: (ctx) => {
                                const total = ctx.dataset.data.reduce(
                                    (a: number, b: number) => a + b,
                                    0,
                                );
                                const pct = (
                                    (ctx.parsed / total) *
                                    100
                                ).toFixed(1);
                                return `${ctx.label}: ${ctx.parsed} (${pct}%)`;
                            },
                        },
                    },
                    datalabels: isMobile
                        ? {
                              color: "#fff",
                              font: { size: 10, weight: "bold" as const },
                              textAlign: "center" as const,
                              formatter: (value: number, ctx: any) => {
                                  if (
                                      !ctx.chart.getDataVisibility(
                                          ctx.dataIndex,
                                      )
                                  )
                                      return "";
                                  const total = ctx.dataset.data.reduce(
                                      (a: number, b: number, i: number) =>
                                          ctx.chart.getDataVisibility(i)
                                              ? a + b
                                              : a,
                                      0,
                                  );
                                  return `${((value / total) * 100).toFixed(1)}%`;
                              },
                          }
                        : {
                              anchor: "end" as const,
                              align: "end" as const,
                              offset: 12,
                              color: "#333",
                              font: { size: 11, weight: "bold" as const },
                              textAlign: "center" as const,
                              formatter: (value: number, ctx: any) => {
                                  if (
                                      !ctx.chart.getDataVisibility(
                                          ctx.dataIndex,
                                      )
                                  )
                                      return "";
                                  const total = ctx.dataset.data.reduce(
                                      (a: number, b: number, i: number) =>
                                          ctx.chart.getDataVisibility(i)
                                              ? a + b
                                              : a,
                                      0,
                                  );
                                  const pct = ((value / total) * 100).toFixed(
                                      1,
                                  );
                                  return `${ctx.chart.data.labels[ctx.dataIndex]}\n${pct}%`;
                              },
                          },
                },
            },
        });
    });
</script>

<style>
    .chart-container {
        position: relative;
        width: 100%;
        max-width: 800px;
        height: 550px;
        margin: 0 auto;
    }
    .chart-title {
        text-align: center;
        margin-bottom: 0.5rem;
        font-size: 1.1rem;
        font-weight: 600;
    }
    @media (max-width: 640px) {
        .chart-container {
            height: 480px;
        }
    }
</style>
