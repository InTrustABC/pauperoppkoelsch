# Melee.gg API Configuration
# Get your credentials from https://melee.gg (user settings)
MELEE_API_CLIENT_ID=your_melee_api_client_id_here
MELEE_API_CLIENT_SECRET=your_melee_api_client_secret_here

# Supabase PostgreSQL Database
# Use the "Transaction mode" connection string from Supabase (port 6543)
DATABASE_URL=postgresql://username:password@host:6543/database_name
